# LLM Configuration for AI-Powered Insights
# Copy this file to .env and add your actual API key

# Enable/disable LLM features
LLM_ENABLED=true

# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-api-key-here

# Model Selection
# Free options: google/gemini-flash-1.5-8b:free, meta-llama/llama-3.2-3b-instruct:free
# Paid options: openai/gpt-4o-mini (~$0.002/summary), anthropic/claude-3.5-sonnet (~$0.025/summary)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Request timeout in seconds
OPENROUTER_TIMEOUT=30

# Your application details (for OpenRouter analytics)
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=PII Benchmark Framework
